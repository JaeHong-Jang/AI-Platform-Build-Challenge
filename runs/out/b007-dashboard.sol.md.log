// Anthropic Messages API 호출 — 성남 KAIST 프로젝트 src/lib/provider.ts의 callModel 방식을 따른다.
// zod → JSON 스키마로 출력 형식을 강제하고, 돌아온 JSON을 zod로 한 번 더 검증한다. 암묵적 재시도는 없다.
import { z } from "zod";
import type { Mode } from "./types.ts";

export const TIMEOUT_MS = 25_000;

export function mode(): Mode {
  return process.env.ANTHROPIC_API_KEY?.trim() ? "live" : "preview";
}
const model = () => process.env.ANTHROPIC_MODEL?.trim() || "claude-sonnet-5-5";

function apiSchema(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(apiSchema);
  if (value && typeof value === "object") {
    const result: Record<string, unknown> = {};
    for (const [key, entry] of Object.entries(value)) {
      if (["$schema", "minLength", "maxLength", "minimum", "maximum", "minItems", "maxItems", "pattern", "format"].includes(key)) continue;
      result[key] = apiSchema(entry);
    }
    if (result.type === "object") result.additionalProperties = false;
    return result;
  }
  return value;
}

export interface ImageInput { mediaType: "image/jpeg" | "image/png" | "image/webp"; data: string } // data: base64

type Block = { type: string; text?: string; id?: string; name?: string; input?: unknown };
export interface ApiResponse { stop_reason?: string; content?: Block[] }

export async function messages(body: Record<string, unknown>): Promise<ApiResponse> {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "content-type": "application/json", "x-api-key": process.env.ANTHROPIC_API_KEY!, "anthropic-version": "2023-06-01" },
    body: JSON.stringify({ model: model(), ...body }),
    signal: AbortSignal.timeout(TIMEOUT_MS),
  });
  if (!res.ok) throw new Error(`모델 API 오류 (${res.status})`);
  return (await res.json()) as ApiResponse;
}

/** 이미지 + 지시 → 스키마에 맞는 JSON 하나. */
export async function callModel<T>(schema: z.ZodType<T>, system: string, images: ImageInput[], instruction: string, maxTokens = 3000): Promise<T> {
  const content = [
    ...images.flatMap((img, n) => [
      { type: "text", text: `사진 ${n + 1}번` },
      { type: "image", source: { type: "base64", media_type: img.mediaType, data: img.data } },
    ]),
    { type: "text", text: instruction },
  ];
  const data = await messages({
    max_tokens: maxTokens,
    system,
    messages: [{ role: "user", content }],
    output_config: { format: { type: "json_schema", schema: apiSchema(z.toJSONSchema(schema)) } },
  });
  if (data.stop_reason !== "end_turn") throw new Error(`모델 응답이 끝나지 않았습니다 (${data.stop_reason ?? "unknown"})`);
  const texts = data.content?.filter((b) => b.type === "text") ?? [];
  if (texts.length !== 1 || !texts[0].text) throw new Error("모델의 구조화 응답이 없습니다");
  return schema.parse(JSON.parse(texts[0].text));
}
