import { z } from "zod";

// ── AI가 만드는 초안 (모델 출력 계약). 사람이 확인하기 전까지는 초안일 뿐이다.

export const itemSchema = z.object({
  name: z.string().describe("품목 이름 (예: 책장, 싱글 침대, 소형 냉장고)"),
  category: z.enum(["대형가구", "가전", "박스·잡화", "기타"]),
  count: z.number().int().describe("사진에 보이는 개수. 확실하지 않으면 가장 그럴듯한 값"),
  photoIds: z.array(z.number().int()).describe("이 품목이 보이는 사진 번호(1부터)"),
  uncertain: z.boolean().describe("가려졌거나 개수·종류가 불확실하면 true"),
  note: z.string().describe("불확실한 이유 등 짧은 메모. 없으면 빈 문자열"),
});
export const itemsDraftSchema = z.object({ items: z.array(itemSchema) });

export const quoteDraftSchema = z.object({
  company: z.string().nullable(),
  totalAmount: z.number().int().nullable().describe("총액(원). 읽지 못하면 null"),
  deposit: z.number().int().nullable().describe("계약금(원). 없거나 읽지 못하면 null"),
  moveDate: z.string().nullable(),
  truck: z.string().nullable().describe("차량 톤수·대수 원문. 없으면 null"),
  workers: z.number().int().nullable().describe("작업 인원. 없으면 null"),
  ladder: z.enum(["포함", "별도", "미기재"]).describe("사다리차 비용이 총액에 포함인지"),
  stairsNote: z.string().nullable().describe("계단 작업·층수 관련 원문. 없으면 null"),
  listedItems: z
    .array(z.object({ name: z.string(), quote: z.string().describe("견적서에 적힌 그대로의 문구") }))
    .describe("견적서에 이름이 적힌 품목"),
  blanketPhrases: z.array(z.string()).describe("'원룸 짐 일체'처럼 품목을 뭉뚱그린 문구, 원문 그대로"),
  extraFeeClauses: z.array(z.string()).describe("추가 비용이 생길 수 있다는 문구, 원문 그대로"),
  unreadable: z.array(z.string()).describe("흐리거나 잘려서 읽지 못한 항목 이름"),
});

export type Item = z.infer<typeof itemSchema> & { id: string; move: boolean };
export type QuoteDraft = z.infer<typeof quoteDraftSchema>;

// ── 사용자가 직접 알려 주는 현장 조건. 모르면 '모름' — 추정으로 채우지 않는다.

export type Tri = "있음" | "없음" | "모름";
export interface Site { floor: number | null; elevator: Tri; parkingFar: Tri }
export interface Conditions { from: Site; to: Site; ladderNeeded: Tri }

// ── 규칙이 만드는 확인 카드. 상태는 네 가지뿐이다 ('위반' 같은 판정은 없다).

export type CardStatus = "명시됨" | "포함 여부 미확인" | "조건 모호" | "판독 불가";
export interface Card {
  id: string;
  rule: "품목" | "작업조건" | "추가비";
  title: string;
  status: CardStatus;
  why: string;
  evidence: string[]; // 견적서 원문 발췌 또는 사진 번호
  ask: string; // 업체에 물을 한 문장 (명시됨이면 빈 문자열)
  refs: string[]; // 참고 조항 id (references.ts)
  answered?: { relation: Relation; quote: string }; // 업체 답변 반영 결과
}

export type Relation = "explicit_answer" | "conditional_answer" | "unanswered" | "conflicting";

export type Mode = "live" | "preview";
// 대조 규칙 — 판정은 여기서만 한다. LLM을 부르지 않는다.
// 규칙 3개: ① 짐 품목 포함 여부 ② 작업조건·차량·인원·장비 기재 여부 ③ 추가비 발생 조건 확인
import type { Card, Conditions, Item, QuoteDraft, Site } from "./types.ts";

// 같은 물건의 다른 이름만 묶는다. 앞의 낱말이 대표 이름. (책상≠식탁, 옷장≠행거, TV≠모니터)
// 긴 이름이 먼저 걸리도록 '티비선반' 같은 복합어는 앞 그룹에 둔다.
const SYNONYMS = [
  ["티비선반", "tv선반", "티비장", "tv장", "거실장"],
  ["책장", "책꽂이", "선반장"],
  ["침대", "침대프레임"],
  ["매트리스"],
  ["책상", "데스크", "컴퓨터책상"],
  ["식탁", "테이블"],
  ["의자"],
  ["옷장"],
  ["행거"],
  ["냉장고"],
  ["세탁기"],
  ["전자레인지"],
  ["소파", "쇼파"],
  ["텔레비전", "tv", "티비"],
  ["모니터"],
  ["건조기"],
  ["에어컨"],
  ["박스", "상자", "짐박스", "이삿짐박스"],
];
const SIZE_WORDS = /(싱글|슈퍼싱글|퀸|킹|소형|중형|대형|미니|원룸용|1인용|2인용|\d+\s*(인치|단|칸|도어|kg|l|리터))/g;

export function canonical(name: string): string {
  const n = name.toLowerCase().replace(SIZE_WORDS, "").replace(/\s+/g, "");
  for (const group of SYNONYMS) if (group.some((w) => n.includes(w))) return group[0];
  return n;
}

const won = (n: number) => n.toLocaleString("ko-KR") + "원";

function itemCards(items: Item[], quote: QuoteDraft): Card[] {
  const cards: Card[] = [];
  const moving = items.filter((i) => i.move && i.count > 0);
  const singles = moving.filter((i) => i.category !== "박스·잡화");
  const boxes = moving.filter((i) => i.category === "박스·잡화");
  const blanket = quote.blanketPhrases[0];

  const judge = (key: string, title: string, label: string, photos: number[], uncertain: boolean): Card => {
    const listed = quote.listedItems.find((l) => canonical(l.name) === key);
    const photo = photos.length ? `사진 ${photos.join("·")}번` : "";
    const sure = uncertain ? " (사진만으로는 개수가 불확실해 확인한 수량 기준)" : "";
    if (listed)
      return { id: `item-${key}`, rule: "품목", title, status: "명시됨", why: `견적서에 '${listed.quote}'로 적혀 있습니다.`, evidence: [listed.quote, photo].filter(Boolean), ask: "", refs: ["art4"] };
    if (blanket)
      return {
        id: `item-${key}`, rule: "품목", title, status: "조건 모호",
        why: `'${blanket}'처럼 뭉뚱그린 문구만 있어 ${label}${sure}가 포함되는지 문서만으로는 확인하기 어렵습니다.`,
        evidence: [blanket, photo].filter(Boolean), ask: `${label}도 총액에 포함된 운송 대상인지`, refs: ["art4"],
      };
    return {
      id: `item-${key}`, rule: "품목", title, status: "포함 여부 미확인",
      why: `견적서에 ${title}이(가) 적혀 있지 않습니다${sure}.`,
      evidence: [photo].filter(Boolean), ask: `${label}도 총액에 포함된 운송 대상인지`, refs: ["art4"],
    };
  };

  // 같은 물건(대표 이름이 같은 것)은 한 카드로 합친다 — 카드 id가 겹치지 않는다.
  const groups = new Map<string, Item[]>();
  for (const i of singles) {
    if (!i.name.trim()) continue;
    const key = canonical(i.name);
    groups.set(key, [...(groups.get(key) ?? []), i]);
  }
  for (const [key, g] of groups) {
    const count = g.reduce((s, i) => s + i.count, 0);
    const title = g.length === 1 ? g[0].name : key;
    const photos = [...new Set(g.flatMap((i) => i.photoIds))].sort();
    cards.push(judge(key, title, `${title} ${count}개`, photos, g.some((i) => i.uncertain)));
  }
  if (boxes.length) {
    const total = boxes.reduce((s, b) => s + b.count, 0);
    const photos = [...new Set(boxes.flatMap((b) => b.photoIds))].sort();
    cards.push(judge("박스", "박스·잡화", `박스·잡화 약 ${total}개`, photos, boxes.some((b) => b.uncertain)));
  }
  return cards;
}

function siteCards(quote: QuoteDraft, cond: Conditions): Card[] {
  const cards: Card[] = [];
  const stated = (id: string, title: string, text: string): Card =>
    ({ id, rule: "작업조건", title, status: "명시됨", why: `견적서에 '${text}'로 적혀 있습니다.`, evidence: [text], ask: "", refs: ["art4"] });
  const missing = (id: string, title: string, why: string, ask: string, refs = ["art4"]): Card =>
    ({ id, rule: "작업조건", title, status: "포함 여부 미확인", why, evidence: [], ask, refs });

  cards.push(quote.truck ? stated("truck", "차량", quote.truck) : missing("truck", "차량", "차량 톤수·대수가 적혀 있지 않습니다. 당일 '차가 부족하다'며 추가 차량을 요구받는 경우가 많습니다.", "배차되는 차량의 톤수와 대수"));
  cards.push(quote.workers !== null ? stated("workers", "작업 인원", `${quote.workers}명`) : missing("workers", "작업 인원", "작업 인원이 적혀 있지 않습니다.", "작업 인원이 몇 명인지"));

  for (const [key, label, site] of [["from", "출발지", cond.from], ["to", "도착지", cond.to]] as const) {
    if (!needsStairs(site)) continue;
    const where = `${label} ${site.floor! < 0 ? `지하 ${-site.floor!}층` : `${site.floor}층`}`;
    const lift = site.elevator === "없음" ? "엘리베이터 없음" : "엘리베이터 사용 여부 모름";
    cards.push(
      quote.stairsNote
        ? { ...stated(`stairs-${key}`, `${label} 계단 작업`, quote.stairsNote), status: "조건 모호", why: `계단 관련 문구('${quote.stairsNote}')는 있지만, ${where}(${lift}) 계단 작업이 총액에 포함되는지는 문구만으로 확인하기 어렵습니다.`, ask: `${where} 계단 작업(${lift})이 총액에 포함되는지` }
        : missing(`stairs-${key}`, `${label} 계단 작업`, `${where}이고 ${lift}인데, 계단 작업에 대한 내용이 견적서에 없습니다.`, `${where} 계단 작업(${lift})이 총액에 포함되는지`),
    );
  }

  const highNoLift = needsLadderQuestion(cond);
  if (quote.ladder === "포함") cards.push(stated("ladder", "사다리차", "사다리차 포함"));
  else if (quote.ladder === "별도")
    cards.push({ id: "ladder", rule: "작업조건", title: "사다리차", status: "조건 모호", why: "사다리차가 '별도'라고만 되어 있고 금액이나 사용 조건이 없습니다.", evidence: ["사다리차 별도"], ask: "사다리차를 쓰게 되면 비용이 얼마이고 어떤 경우에 쓰는지", refs: ["art4", "art8-2"] });
  else if (cond.ladderNeeded === "있음" || (cond.ladderNeeded === "모름" && highNoLift))
    cards.push(missing("ladder", "사다리차", "사다리차가 필요할 수 있는 조건인데 견적서에 사다리차 내용이 없습니다.", "사다리차가 필요한지, 필요하면 비용이 총액에 포함되는지", ["art4", "art8-2"]));

  for (const [key, label, site] of [["from", "출발지", cond.from], ["to", "도착지", cond.to]] as const)
    if (site.parkingFar === "있음")
      cards.push(missing(`carry-${key}`, `${label} 운반 거리`, `${label}에서 차를 대는 곳이 멀다고 하셨는데, 운반 거리에 대한 내용이 견적서에 없습니다.`, `${label}의 차량 정차 위치가 멀어도 추가 비용이 없는지`));
  return cards;
}

function feeCards(quote: QuoteDraft): Card[] {
  if (!quote.extraFeeClauses.length)
    return [{ id: "fee-none", rule: "추가비", title: "당일 추가 비용 조건", status: "포함 여부 미확인", why: "추가 비용이 생기는 경우에 대한 문구가 없습니다. 당일 짐 양·건물 구조를 이유로 추가 비용을 요구하는 사례가 가장 흔합니다.", evidence: [], ask: "당일 추가 비용이 생길 수 있는 경우가 있다면 항목과 금액", refs: ["art8-2", "art8-3"] }];
  return quote.extraFeeClauses.map((c, n) => ({
    id: `fee-${n}`, rule: "추가비" as const, title: "추가 비용 문구", status: "조건 모호" as const,
    why: "추가 비용이 생길 수 있다는 문구는 있지만, 어떤 경우에 얼마가 붙는지는 적혀 있지 않습니다.",
    evidence: [c], ask: "어떤 경우에 얼마가 추가되는지 항목·조건·금액(또는 산정 방식)", refs: ["art5-3", "art8-2", "art8-3"],
  }));
}

// 사용자가 확인 화면에서 직접 채운 값은 더 이상 '판독 불가'가 아니다.
const FILLED: Record<string, (q: QuoteDraft) => boolean> = {
  총액: (q) => q.totalAmount !== null,
  계약금: (q) => q.deposit !== null,
  차량: (q) => q.truck !== null,
  인원: (q) => q.workers !== null,
  "작업 인원": (q) => q.workers !== null,
  이사일: (q) => q.moveDate !== null,
};

function unreadableCards(quote: QuoteDraft): Card[] {
  const fields = quote.unreadable.filter((f) => !FILLED[f]?.(quote));
  if (quote.totalAmount === null && !fields.includes("총액")) fields.unshift("총액");
  return fields.map((f) => ({
    id: `unread-${f}`, rule: "작업조건" as const, title: f, status: "판독 불가" as const,
    why: `견적서에서 '${f}'을(를) 읽지 못했습니다. 앞 화면에서 직접 입력하거나, 업체에 다시 물어볼 수 있어요.`,
    evidence: [], ask: `견적서의 '${f}' 부분이 잘 보이지 않는데, 다시 알려 주실 수 있는지`, refs: [],
  }));
}

/** 계단 작업이 생길 수 있는 층: 2층 이상이나 지하이고, 엘리베이터가 없거나 모를 때 */
function needsStairs(s: Site): boolean {
  return s.floor !== null && (s.floor >= 2 || s.floor < 0) && s.elevator !== "있음";
}

/** 사다리차 필요 여부를 물어야 하는 조건: 3층 이상인데 엘리베이터를 쓸 수 있는지 확실하지 않음 */
function needsLadderQuestion(cond: Conditions): boolean {
  return [cond.from, cond.to].some((s) => s.floor !== null && s.floor >= 3 && s.elevator !== "있음");
}

export function compare(items: Item[], quote: QuoteDraft, cond: Conditions): Card[] {
  return [...unreadableCards(quote), ...itemCards(items, quote), ...siteCards(quote, cond), ...feeCards(quote)];
}

/** 사용자만 아는 사실 중 비어 있는 것 — 다시 묻는다. (고정 항목이라 에이전트가 필요 없다) */
export function missingFacts(cond: Conditions): string[] {
  const out: string[] = [];
  for (const [label, s] of [["출발지", cond.from], ["도착지", cond.to]] as const) {
    if (s.floor === null) out.push(`${label}가 몇 층인지`);
    if (s.elevator === "모름") out.push(`${label}에서 엘리베이터를 쓸 수 있는지`);
  }
  if (needsLadderQuestion(cond) && cond.ladderNeeded === "모름") out.push("사다리차가 필요한지 (모르면 업체에 같이 물어봅니다)");
  return out;
}

export const summary = (q: QuoteDraft) => [q.company, q.totalAmount !== null ? won(q.totalAmount) : null].filter(Boolean).join(" · ");
export { won };

