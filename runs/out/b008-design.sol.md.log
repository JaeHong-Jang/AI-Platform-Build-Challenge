   142	        <label className="field" style={{ flex: 1 }}><span>작업 인원</span><input type="text" inputMode="numeric" value={quote.workers ?? ""} onChange={(e) => set({ workers: num(e.target.value) })} placeholder="적혀 있지 않음" /></label>
