   173	    }
   174	    for (const c of calls) {
   175	      if (steps.length >= MAX_TOOL_CALLS) return finalize(model, cards, tools, steps, "limit", `도구 호출 상한(${MAX_TOOL_CALLS}회)에 도달해 멈췄습니다.`);
   176	      const name = c.function?.name ?? "?";
   177	      const input = toolArgs(c.function?.arguments);
   178	      const output = exec(tools, name, input);
   179	      steps.push({ n: steps.length + 1, tool: name, input, output, ms: c === calls[0] ? r.ms : 0 }); // 모델 응답 시간은 그 턴의 첫 도구에
