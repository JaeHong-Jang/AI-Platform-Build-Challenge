    27	export function ollamaUrl(): string {
    28	  const env = process.env.OLLAMA_URL?.trim();
    29	  if (env) return env.replace(/\/$/, "");
    30	  const host = wslHost();
    31	  return `http://${host ?? "127.0.0.1"}:11434`;
    32	}
