     3	// 구조화 출력은 format에 JSON 스키마를 준다 (format:"json"은 스키마를 무시한다 — runs/out/b007-ollama.sonnet.md 실측)
     4	import { readFileSync } from "node:fs";
     5	import { z } from "zod";
