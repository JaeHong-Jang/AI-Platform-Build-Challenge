    36	export async function health(): Promise<Health> {
    37	  const url = ollamaUrl();
    38	  const base = { url, agent: { name: AGENT_MODEL(), ready: false }, reader: { name: READER_MODEL(), ready: false } };
    39	  try {
    40	    const res = await fetch(`${url}/api/tags`, { signal: AbortSignal.timeout(3000) });
    41	    if (!res.ok) return { ...base, ok: false, models: [], error: `Ollama ${res.status}` };
    42	    const models: string[] = ((await res.json()).models ?? []).map((m: { name: string }) => m.name);
    43	    return { ok: true, url, models, agent: { ...base.agent, ready: models.includes(AGENT_MODEL()) }, reader: { ...base.reader, ready: models.includes(READER_MODEL()) } };
    44	  } catch {
    45	    return { ...base, ok: false, models: [], error: "Ollama에 연결할 수 없습니다" };
    46	  }
    47	}
