    30	  const ladder = d.ladder !== "미기재" && !/사다리/.test(text) ? (dropped.push(`사다리차: '${d.ladder}' (원문에 사다리 언급 없음)`), "미기재" as const) : d.ladder;
    31	
    32	  const draft: QuoteDraft = {
    33	    ...d,
    34	    company: has(d.company) ? d.company : null,
    35	    moveDate: has(d.moveDate) ? d.moveDate : null,
    36	    truck: d.truck && keep("차량", d.truck) ? d.truck : null,
    37	    ladder,
    38	    stairsNote: d.stairsNote && keep("계단 문구", d.stairsNote) ? d.stairsNote : null,
    39	    listedItems: items,
    40	    blanketPhrases: d.blanketPhrases.filter((b) => keep("뭉뚱그린 문구", b)),
    41	    extraFeeClauses: d.extraFeeClauses.filter((c) => keep("추가비 문구", c)),
    42	    unreadable: [...d.unreadable],
    43	  };
    44	  for (const [key, label] of [["totalAmount", "총액"], ["deposit", "계약금"]] as const) {
    45	    const v = d[key];
    46	    if (v !== null && !amountInText(v, text)) {
    47	      dropped.push(`${label}: ${v.toLocaleString("ko-KR")}원 (원문에 없는 숫자)`);
    48	      draft[key] = null;
    49	      if (!draft.unreadable.includes(label)) draft.unreadable.push(label);
    50	    }
    51	  }
