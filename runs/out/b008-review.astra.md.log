     2	// 한 건의 이사(견적 1개)를 브라우저 세션에 보관한다. 서버에는 저장하지 않는다.
     3	// 저장소 접근은 실패할 수 있다 (사생활 보호 모드 등) — TRITON store.ts 방식으로 감싼다.
     4	import { useEffect, useMemo, useState } from "react";
     5	import { compare } from "./rules.ts";
     6	import type { AgentRun } from "./agent.ts";
     7	import type { Card, CardStatus, Conditions, Cost, Inquiry, Item, QuoteDraft, Relation } from "./types.ts";
     8	
     9	export interface Override { sig: string; status: CardStatus; cost: Cost; answered: { relation: Relation; quote: string } }
    10	
    11	export interface CaseState {
    12	  quoteText: string;
    13	  draft: QuoteDraft | null;
    14	  dropped: string[];
    15	  reader: { model: string; ms: number } | null;
    16	  items: Item[];
    17	  cond: Conditions;
    18	  asked: string[]; // 문의에 넣은 카드 id
    19	  inquiry: Record<string, Inquiry>;
    20	  overrides: Record<string, Override>; // 사용자가 승인한 답변 반영
    21	  reply: string;
    22	  runs: AgentRun[];
    23	}
    24	
    25	export const EMPTY_CASE: CaseState = {
    26	  quoteText: "",
    27	  draft: null,
    28	  dropped: [],
    29	  reader: null,
    30	  items: [],
    31	  cond: { from: { floor: null, elevator: "모름", parkingFar: "모름" }, to: { floor: null, elevator: "모름", parkingFar: "모름" }, ladderNeeded: "모름" },
    32	  asked: [],
    33	  inquiry: {},
    34	  overrides: {},
    35	  reply: "",
    36	  runs: [],
    37	};
    38	
    39	const KEY = "isa-case-v2";
    40	
    41	/** 입력(짐 수량·조건·견적 총액·업체)이 바뀌면 예전 승인은 적용하지 않는다 (Sol: 오래된 후보 적용 금지) */
    42	export const sigOf = (c: Card, d: QuoteDraft | null) => [c.status, c.mine, ...c.evidence, d?.totalAmount ?? "", d?.company ?? ""].join("|");
    43	
    44	/** 승인 반영 전, 입력만으로 만든 카드 — 승인할 때 sig는 이걸로 잡는다 */
    45	export const baseCards = (s: CaseState): Card[] => (s.draft ? compare(s.items, s.draft, s.cond) : []);
    46	
    47	export function cardsOf(s: CaseState): Card[] {
    48	  return baseCards(s).map((c) => {
    49	    const o = s.overrides[c.id];
    50	    return o && o.sig === sigOf(c, s.draft) ? { ...c, status: o.status, cost: o.cost ?? c.cost, answered: o.answered } : c;
    51	  });
    52	}
    53	
    54	/** 문의 상태는 승인과 함께 움직인다: 승인이 무효가 되면 '답변 반영'은 '재문의 필요'로 본다 */
    55	export function inquiryOf(s: CaseState, cards: Card[]): Record<string, Inquiry> {
    56	  const out: Record<string, Inquiry> = {};
    57	  for (const c of cards) {
    58	    const q = s.inquiry[c.id];
    59	    if (!q) continue;
    60	    out[c.id] = q === "답변 반영" && !c.answered ? "재문의 필요" : q;
    61	  }
    62	  return out;
    63	}
    64	
    65	export function useCase() {
    66	  const [state, setState] = useState<CaseState>(EMPTY_CASE);
    67	  const [loaded, setLoaded] = useState(false);
    68	
    69	  useEffect(() => {
    70	    try {
    71	      const raw = sessionStorage.getItem(KEY);
    72	      if (raw) setState({ ...EMPTY_CASE, ...JSON.parse(raw) });
    73	    } catch { /* 저장소를 못 쓰면 새로 시작 */ }
    74	    setLoaded(true);
    75	  }, []);
    76	
    77	  useEffect(() => {
    78	    if (!loaded) return;
    79	    try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch { /* 무시 */ }
    80	  }, [state, loaded]);
    81	
    82	  const cards = useMemo(() => cardsOf(state), [state]);
    83	  const inquiry = useMemo(() => inquiryOf(state, cards), [state, cards]);
    84	  const update = (patch: Partial<CaseState> | ((s: CaseState) => Partial<CaseState>)) =>
    85	    setState((s) => ({ ...s, ...(typeof patch === "function" ? patch(s) : patch) }));
    86	  return { state, cards, inquiry, update, reset: () => setState(EMPTY_CASE), loaded };
    87	}
    88	
    89	export type CaseApi = ReturnType<typeof useCase>;

