    67	/** system + user → 스키마에 맞는 JSON 하나. 스키마를 어기면 throw. */
    68	export async function chatJSON<T>(model: string, schema: z.ZodType<T>, system: string, user: string): Promise<{ data: T; ms: number }> {
    69	  const r = await chat(model, {
    70	    format: z.toJSONSchema(schema),
    71	    messages: [{ role: "system", content: system }, { role: "user", content: user }],
    72	  });
    73	  return { data: schema.parse(JSON.parse(r.message.content)), ms: r.ms };
