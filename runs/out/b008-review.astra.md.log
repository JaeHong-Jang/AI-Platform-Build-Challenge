    16	function wslHost(): string | null {
    17	  try {
    18	    if (!/microsoft/i.test(readFileSync("/proc/version", "utf8"))) return null;
    19	    for (const line of readFileSync("/proc/net/route", "utf8").split("\n").slice(1)) {
    20	      const [, dest, gw] = line.trim().split(/\s+/);
    21	      if (dest === "00000000" && gw) return gw.match(/../g)!.reverse().map((h) => parseInt(h, 16)).join(".");
    22	    }
    23	  } catch { /* 리눅스가 아니면 무시 */ }
    24	  return null;
    25	}
