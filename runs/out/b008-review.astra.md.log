    11	const COLD_TIMEOUT_MS = 180_000;
    12	const WARM_TIMEOUT_MS = 90_000;
    13	// 8GB GPU에서는 두 모델을 번갈아 쓰면 다시 올린다 — 직전에 쓴 모델과 같을 때만 '따뜻한' 것으로 본다
