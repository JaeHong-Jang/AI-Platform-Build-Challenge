    49	export interface ChatMessage { role: "system" | "user" | "assistant" | "tool"; content: string; tool_calls?: ToolCall[]; tool_name?: string }
    50	export interface ToolCall { function: { name: string; arguments: unknown } }
    51	export interface ChatReply { message: ChatMessage; ms: number; done_reason?: string }
    52	
    53	export async function chat(model: string, body: Record<string, unknown>): Promise<ChatReply> {
    54	  const t0 = Date.now();
    55	  const res = await fetch(`${ollamaUrl()}/api/chat`, {
    56	    method: "POST",
    57	    headers: { "content-type": "application/json" },
    58	    body: JSON.stringify({ model, stream: false, keep_alive: "30m", options: { temperature: 0, num_ctx: 8192 }, ...body }),
    59	    signal: AbortSignal.timeout(lastModel === model ? WARM_TIMEOUT_MS : COLD_TIMEOUT_MS),
    60	  });
    61	  if (!res.ok) throw new Error(`Ollama ${res.status}: ${(await res.text()).slice(0, 200)}`);
    62	  const data = await res.json();
    63	  lastModel = model;
    64	  return { message: data.message, ms: Date.now() - t0, done_reason: data.done_reason };
    65	}
