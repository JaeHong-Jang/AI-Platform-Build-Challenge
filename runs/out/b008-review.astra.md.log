   136	  if (quote.totalAmount === null && !fields.includes("총액")) fields.unshift("총액");
   137	  return fields.map((f) => ({
   138	    id: `unread-${f}`, rule: "작업조건" as const, title: f, mine: "—", status: "판독 불가" as const, cost: "미확인" as const,
   139	    why: `견적서에서 '${f}'을(를) 확인하지 못했습니다. 직접 입력하거나 업체에 다시 물어볼 수 있어요.`,
   140	    evidence: [], ask: `견적서의 '${f}'을(를) 다시 알려 주실 수 있는지`, refs: [],
   141	  }));
   142	}
   143	
   144	/** 계단 작업이 생길 수 있는 층: 2층 이상이나 지하이고, 엘리베이터가 없거나 모를 때 */
   145	function needsStairs(s: Site): boolean {
   146	  return s.floor !== null && (s.floor >= 2 || s.floor < 0) && s.elevator !== "있음";
   147	}
   148	
   149	/** 사다리차 필요 여부를 물어야 하는 조건: 3층 이상인데 엘리베이터를 쓸 수 있는지 확실하지 않음 */
   150	function needsLadderQuestion(cond: Conditions): boolean {
   151	  return [cond.from, cond.to].some((s) => s.floor !== null && s.floor >= 3 && s.elevator !== "있음");
   152	}
   153	
   154	export function compare(items: Item[], quote: QuoteDraft, cond: Conditions): Card[] {
   155	  return [...unreadableCards(quote), ...itemCards(items, quote), ...siteCards(quote, cond), ...feeCards(quote)];
   156	}
   157	
   158	/** 사용자만 아는 사실 중 비어 있는 것 — 대시보드가 먼저 묻는다. (고정 항목이라 에이전트가 필요 없다) */
   159	export function missingFacts(cond: Conditions, items: Item[]): string[] {
   160	  const out: string[] = [];
   161	  if (!items.some((i) => i.move && i.count > 0)) out.push("옮길 짐 목록");
   162	  for (const [label, s] of [["출발지", cond.from], ["도착지", cond.to]] as const) {
   163	    if (s.floor === null) out.push(`${label} 층수`);
   164	    else if (s.elevator === "모름") out.push(`${label} 엘리베이터 사용 여부`);
   165	  }
   166	  if (needsLadderQuestion(cond) && cond.ladderNeeded === "모름") out.push("사다리차 필요 여부");
   167	  return out;
   168	}
