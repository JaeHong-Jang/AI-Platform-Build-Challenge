     6	/** 원문의 금액 표기를 모두 원 단위로 읽는다: 350,000원 / 35만원 / 35만 5천원 / 3만5천원 */
     7	export function amountsIn(text: string): number[] {
     8	  const t = text.replace(/\s+/g, "");
     9	  const out: number[] = [];
    10	  for (const m of t.matchAll(/(?<![\d,])(\d{1,4})만(?:(\d)천)?/g)) out.push(Number(m[1]) * 10000 + (m[2] ? Number(m[2]) * 1000 : 0));
    11	  for (const m of t.matchAll(/(?<![\d,])(\d{1,3}(?:,\d{3})+|\d+)(?![\d,]|만|천)/g)) out.push(Number(m[1].replace(/,/g, "")));
    12	  return out;
    13	}
